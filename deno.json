{
  "tasks": {
    "bundle": "deno bundle public/main.js > docs/main.js",
    "copy2docs": "cd public/; cp *.css index.html favicon.svg ../docs/; cd ../",
    "dist": "deno task bundle && deno task copy2docs",
    "dev": "deno run --allow-net --allow-read jsr:@std/http/file-server public/",
    "prd": "deno run --allow-net --allow-read jsr:@std/http/file-server docs/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  }
}
